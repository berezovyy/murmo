# Research evidence: kept on disk, cited by docs/, never committed (third-party sources, binaries).
/experiments/

# Design docs, the build plan and research notes: kept on disk, never committed.
/docs/

# Dependencies and build output
node_modules/
dist/
target/
*.tsbuildinfo

# Measurement outputs (tools/runs.mjs keeps the newest 3 per measurement)
/.runs/

# Real-host harness: run evidence (newest 3 per measurement) and the host cache
/harness/out/
/.harness-cache/
__pycache__/

# Local state
.DS_Store
*.log

# pnpm puts its store in the checkout when HOME is on another filesystem (containers)
/.pnpm-store/

# Agent worktrees made by Claude Code
/.claude/worktrees/

# README film: only the rendered films and the README logo are committed; the HyperFrames
# source, render script and masters stay on disk.
/media/*
!/media/films/
!/media/logo/
/media/logo/*
!/media/logo/logo.png
