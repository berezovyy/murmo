{
  "name": "file-picker",
  "version": "0.1.0",
  "api": "^2.0.0",
  "entry": "plugin.mjs",
  "permissions": [
    { "name": "draft:read", "reason": "See the ~f: trigger you type." },
    { "name": "draft:write", "reason": "Insert the path you pick." },
    { "name": "fs:project-read", "reason": "Read the generated file index in .murmo-files/." }
  ],
  "capabilities": { "required": { "menu": true, "runtime.services": ["project.read"] }, "optional": {} },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "indexPath": { "type": "string", "maxLength": 256, "default": ".murmo-files/index.json" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 30, "default": 12 }
    },
    "additionalProperties": false
  }
}
