{
  "name": "@murmo/provenance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@murmo/api": "workspace:*",
    "@murmo/text": "workspace:*"
  },
  "devDependencies": {
    "@murmo/fixtures": "workspace:*"
  },
  "murmo": {
    "runtime": "portable",
    "bundles": [
      {
        "name": "provenance",
        "entry": "src/index.ts",
        "targets": [
          "node",
          "bun",
          "claude",
          "quickjs"
        ],
        "global": "MurmoProvenance"
      }
    ]
  }
}
