{
  "name": "@murmo/adapter-pi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./dist/node/pi.js"
    ]
  },
  "dependencies": {
    "@murmo/api": "workspace:*",
    "@murmo/config": "workspace:*",
    "@murmo/core": "workspace:*",
    "@murmo/executor": "workspace:*",
    "@murmo/plugin-autocorrect": "workspace:*",
    "@murmo/plugin-events": "workspace:*",
    "@murmo/plugin-history": "workspace:*",
    "@murmo/plugin-phrases": "workspace:*",
    "@murmo/plugin-rescue": "workspace:*",
    "@murmo/plugin-shortcuts": "workspace:*",
    "@murmo/provenance": "workspace:*",
    "@murmo/store": "workspace:*",
    "@murmo/text": "workspace:*"
  },
  "murmo": {
    "runtime": "node",
    "bundles": [
      {
        "name": "pi",
        "entry": "src/index.ts",
        "targets": [
          "node"
        ],
        "external": [
          "@earendil-works/pi-coding-agent",
          "@earendil-works/pi-tui"
        ]
      }
    ]
  }
}
