{
  "name": "@murmo/lang",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "murmo": {
    "runtime": "portable",
    "bundles": [
      {
        "name": "lang",
        "entry": "src/index.ts",
        "targets": [
          "node",
          "bun",
          "claude",
          "quickjs"
        ],
        "global": "MurmoLang"
      }
    ]
  }
}
