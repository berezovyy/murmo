{
  "name": "@murmo/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "murmo": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/cli.ts"
  },
  "dependencies": {
    "@murmo/api": "workspace:*",
    "@murmo/config": "workspace:*",
    "@murmo/core": "workspace:*",
    "@murmo/devkit": "workspace:*",
    "@murmo/executor": "workspace:*",
    "@murmo/integrity": "workspace:*",
    "@murmo/lang": "workspace:*",
    "@murmo/plugin-autocorrect": "workspace:*",
    "@murmo/plugin-phrases": "workspace:*",
    "@murmo/plugin-shortcuts": "workspace:*",
    "@murmo/store": "workspace:*",
    "@murmo/vocab": "workspace:*"
  },
  "murmo": {
    "runtime": "node",
    "bundles": [
      {
        "name": "cli",
        "entry": "src/cli.ts",
        "targets": [
          "node"
        ],
        "external": [
          "@murmo/devkit",
          "quickjs-emscripten"
        ]
      }
    ]
  }
}
