{
  "name": "@murmo/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "murmo": {
    "runtime": "portable",
    "nodeOnly": [
      "src/node"
    ],
    "bundles": [
      {
        "name": "config",
        "entry": "src/index.ts",
        "targets": [
          "node",
          "bun",
          "claude",
          "quickjs"
        ],
        "global": "MurmoConfig"
      }
    ]
  },
  "dependencies": {
    "@murmo/api": "workspace:*",
    "@murmo/store": "workspace:*",
    "@murmo/text": "workspace:*",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@murmo/fixtures": "workspace:*"
  }
}
