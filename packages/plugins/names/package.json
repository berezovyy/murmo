{
  "name": "@murmo/plugin-names",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@murmo/api": "workspace:*",
    "@murmo/core": "workspace:*",
    "@murmo/vocab": "workspace:*"
  },
  "devDependencies": {
    "@murmo/fixtures": "workspace:*"
  },
  "murmo": {
    "runtime": "portable",
    "bundles": [
      {
        "name": "plugin-names",
        "entry": "src/index.ts",
        "targets": [
          "node",
          "bun",
          "claude",
          "quickjs"
        ],
        "global": "MurmoPluginNames"
      }
    ]
  }
}
