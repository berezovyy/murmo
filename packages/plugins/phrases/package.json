{
  "name": "@murmo/plugin-phrases",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "dependencies": {
    "@murmo/api": "workspace:*",
    "@murmo/store": "workspace:*",
    "@murmo/text": "workspace:*"
  },
  "devDependencies": {
    "@murmo/core": "workspace:*"
  },
  "murmo": {
    "runtime": "portable",
    "nodeOnly": [
      "src/node"
    ],
    "bundles": [
      {
        "name": "plugin-phrases",
        "entry": "src/index.ts",
        "targets": [
          "node",
          "bun",
          "claude",
          "quickjs"
        ],
        "global": "MurmoPluginPhrases"
      }
    ]
  }
}
