  "cases": [
    {
      "id": "span-ends-inside-pair",
      "note": "A span edge between the halves of a pair masks the whole pair: the guest never gets half an emoji",
      "input": {
        "draft": {
          "text": "a😀b",
          "cursor": 4,
          "typedSpans": [[0, 2]]
        },
        "evidence": "host-labeled"
      },
      "output": {
        "text": "a███",
        "cursor": 4,
        "selection": null,
        "typedSpans": [[0, 1]]
      }
    },
    {
      "id": "span-starts-inside-pair",
      "input": {
        "draft": {
          "text": "a😀b",
          "cursor": 4,
          "typedSpans": [[2, 4]]
        },
        "evidence": "host-labeled"
      },
      "output": {
        "text": "███b",
        "cursor": 4,
        "selection": null,
        "typedSpans": [[3, 4]]
      }
    },
    {
      "id": "typed-lone-surrogate-masked",
      "input": {
        "draft": {
          "text": "x\ud800y",
          "cursor": 3,
          "typedSpans": [[0, 3]]
        },
        "evidence": "host-labeled"
      },
      "output": {
        "text": "x█y",
        "cursor": 3,
        "selection": null,
        "typedSpans": [[0, 1], [2, 3]]
      }
    },
    {
      "id": "whole-pair-revealed",
      "input": {
        "draft": {
          "text": "a😀b",
          "cursor": 1,
          "typedSpans": [[1, 3]]
        },
        "evidence": "host-labeled"
      },
      "output": {
        "text": "█😀█",
        "cursor": 1,
        "selection": null,
        "typedSpans": [[1, 3]]
      }
    },
    {
      "id": "cursor-and-selection-kept-fully-masked",
      "input": {
        "draft": {
          "text": "hello",
          "cursor": 2,
          "selection": [1, 3],
          "typedSpans": [[0, 5]]
        },
        "evidence": "observed-unmarked"
      },
      "output": {
