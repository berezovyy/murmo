          {
            "origin": "paste",
            "from": 2,
            "to": 2,
            "insert": "XY"
          },
          {
            "origin": "typed",
            "from": 4,
            "to": 4,
            "insert": "c"
          }
        ]
      },
      "output": [
        {
          "origin": "typed",
          "from": 0,
          "to": 0,
          "insert": "ab"
        },
        {
          "origin": "paste",
          "from": 2,
          "to": 2,
          "insert": "XY"
        },
        {
          "origin": "typed",
          "from": 4,
          "to": 4,
          "insert": "c"
