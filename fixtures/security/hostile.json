          "settings": {
            "mode": "counter"
          }
        }
      ],
      "steps": [
        {
          "fill": "draft0"
        },
        {
          "fill": "draft1"
        },
        {
          "fill": "draft2"
        },
        {
          "fill": "draft3"
        }
      ],
      "expect": {
        "disabled": ["loop"],
        "enabled": ["healthy"],
        "ui": {
          "statusIncludes": "healthy 4"
        }
      },
      "skip": [
        {
          "executor": "in-process",
          "reason": "CPU containment requires the isolated executor"
        }
      ]
