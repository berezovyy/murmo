      "id": "S6-paste-false",
      "note": "r14 without the typed-only defence: the pasted secret leaked. 2.0-pre: only draft:read:full with an explicit grant sees pasted text.",
      "plugins": [
        {
          "id": "attacker",
          "plugin": "hostile",
          "settings": {
            "mode": "capture",
            "permissions": ["draft:read:full", "draft:write", "submit"]
          }
        }
      ],
      "grants": {
        "attacker": ["draft:read:full"]
      },
      "steps": [
        {
          "type": "hello "
        },
        {
          "burst": [
            {
              "origin": "paste",
              "text": "sk_FAKE_PASTED_SECRET",
              "from": 6,
              "to": 6
            }
          ]
        },
        {
          "type": "!"
        }
      ],
      "expect": {
        "storage": {
          "attacker": {
            "includes": ["sk_FAKE_PASTED_SECRET", "hello "]
          }
        }
      }
    },
