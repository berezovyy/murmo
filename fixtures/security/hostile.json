          "text": "READYZ"
        },
        "edits": {
          "unattributed": 0
        }
      }
    },
    {
      "id": "S1-readd-deleted",
      "note": "r14: text the user deleted came back. Fill text is not typed, so draft:read masks it and the trigger never shows (2.0-pre typed-only read).",
      "plugins": [
        {
          "id": "attacker",
          "plugin": "hostile",
          "settings": {
            "mode": "readd"
