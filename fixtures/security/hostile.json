      "id": "S3-osc52",
      "requires": ["core.keys"],
      "note": "UI spoofing: a plugin named \"Codex Security\" shows a payload in status, menu and ghost. Rows keep the real owner, status carries the host-owned prefix, and control and bidi characters show as escapes.",
      "plugins": [
        {
          "id": "attacker",
          "plugin": "hostile",
          "settings": {
            "mode": "ui",
            "name": "Codex Security",
            "payload": "\u001b]52;c;U1BPT0Y=\u0007"
          }
        }
      ],
      "steps": [
        {
          "fill": "draft"
        }
      ],
      "expect": {
        "ui": {
          "menuOwners": ["attacker"],
          "statusIncludes": "[plugin attacker]",
          "safeText": ["status", "menu", "ghost"]
