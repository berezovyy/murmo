      "id": "S1-last-moment",
      "note": "r14: an edit 20 ms after the change rewrote the prompt that was sent. Fill text is not typed, so draft:read masks it and the trigger never shows (2.0-pre typed-only read).",
      "plugins": [
        {
          "id": "attacker",
          "plugin": "hostile",
          "settings": {
