    {
      "id": "S4-grant-has-no-broker",
      "note": "A network grant with no network broker gives the guest nothing: no fetch, no ctx.network.",
      "plugins": [
        {
          "id": "attacker",
          "plugin": "hostile",
          "settings": {
            "mode": "ambient",
            "permissions": ["draft:read", "network"]
          }
        }
      ],
      "grants": {
        "attacker": ["draft:read", "network"]
      },
      "steps": [
        {
          "settle": true
        }
      ],
      "expect": {
        "ui": {
          "statusIncludes": ["\"fetch\":\"undefined\"", "\"network\":\"undefined\""]
        }
      },
      "skip": [
        {
          "executor": "in-process",
          "reason": "the in-process executor shares the host globals; ambient API absence is an isolated-executor property"
        }
      ]
    },
    {
      "id": "S5-storage-settings-ui",
      "note": "One plugin cannot read another plugin's storage, settings or UI.",
      "plugins": [
        {
          "id": "victim",
          "plugin": "hostile",
          "settings": {
            "mode": "storage-victim",
            "privateSetting": "VICTIM-SETTING"
          }
        },
        {
          "id": "spy",
          "plugin": "hostile",
          "settings": {
            "mode": "storage-spy"
          }
        }
      ],
      "steps": [
        {
          "settle": true
        }
      ],
      "expect": {
        "storage": {
          "victim": {
            "includes": ["VICTIM-PRIVATE"]
          },
          "spy": {
            "includes": ["SPY-PRIVATE"],
            "excludes": ["VICTIM-PRIVATE", "VICTIM-SETTING"]
          }
        },
        "never": {
          "status": ["VICTIM-PRIVATE", "VICTIM-SETTING"]
        }
      }
    },
    {
      "id": "S5-key-hijack-with-no-permissions",
      "requires": ["core.keys"],
      "note": "r14: a plugin with no permissions claimed Tab always/consume and swallowed the victim's accept-ghost. 2.0-pre refuses the third-party shared-key claim, so Tab reaches the victim.",
      "plugins": [
        {
          "id": "hog",
          "plugin": "hostile",
          "settings": {
            "mode": "none",
            "permissions": [],
            "keys": [
              {
                "key": "Tab",
                "when": ["always"],
                "action": "consume"
              }
            ]
          }
        },
        {
          "id": "victim",
          "plugin": "hostile",
          "settings": {
            "mode": "ghost-only",
            "keys": [
              {
                "key": "Tab",
                "when": ["ghost-visible-by-me"],
                "action": "accept-ghost"
              }
            ]
          }
        }
      ],
      "steps": [
        {
          "fill": "draft"
        },
        {
          "check": {
            "ui": {
              "ghost": "suggestion"
            }
          }
        },
        {
          "key": "Tab",
          "routing": "consume"
        }
      ],
      "expect": {
        "draft": {
          "text": "draftsuggestion"
        },
        "ui": {
          "ghost": null
        }
      }
    },
