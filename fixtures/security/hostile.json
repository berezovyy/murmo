            "max": 128
          },
          "statusLength": {
            "max": 512
          }
        }
      }
    },
    {
      "id": "S5-cpu-peers",
      "note": "A looping plugin is disabled; its healthy peer keeps working.",
      "plugins": [
        {
          "id": "loop",
          "plugin": "hostile",
          "settings": {
            "mode": "loop"
          }
        },
        {
          "id": "healthy",
