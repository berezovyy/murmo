{
  "kind": "pure-fn/v1",
  "offsets": "utf16",
  "provenance": {
    "source": "new case list for experiments/platform/shared-v2/brokers/text-policy.ts (unsafeText); outputs from that prototype",
    "license": "Apache-2.0 OR MIT",
    "author": "murmo"
  },
  "fn": "text.unsafe",
  "cases": [
    {
      "id": "plain",
      "input": {
        "text": "hello world"
      },
      "output": null
    },
    {
      "id": "tab-lf-cr-allowed",
      "input": {
        "text": "a\tb\nc\r\nd"
      },
      "output": null
    },
    {
      "id": "emoji-and-zwj-allowed",
      "input": {
        "text": "👩\u200d💻 café"
      },
      "output": null
    },
    {
      "id": "lrm-allowed",
      "input": {
        "text": "a\u200eb"
      },
      "output": null
    },
    {
      "id": "ansi-escape",
      "input": {
        "text": "red \u001b[31mtext"
      },
      "output": "control or terminal escape sequence"
    },
    {
      "id": "osc-hyperlink",
      "input": {
        "text": "\u001b]8;;https://example.invalid\u0007x\u001b]8;;\u0007"
      },
      "output": "control or terminal escape sequence"
    },
    {
      "id": "nul",
      "input": {
        "text": "a\u0000b"
      },
      "output": "control or terminal escape sequence"
    },
    {
      "id": "bell",
      "input": {
        "text": "ding\u0007"
      },
      "output": "control or terminal escape sequence"
    },
    {
      "id": "vertical-tab",
      "input": {
        "text": "a\u000bb"
      },
      "output": "control or terminal escape sequence"
    },
    {
      "id": "del",
      "input": {
        "text": "a\u007f"
      },
      "output": "control or terminal escape sequence"
    },
    {
      "id": "c1-csi",
      "input": {
        "text": "\u009b31m"
      },
      "output": "control or terminal escape sequence"
    },
    {
      "id": "bidi-override",
      "input": {
        "text": "invoice\u202efdp.exe"
      },
      "output": "bidirectional override/isolate"
    },
    {
      "id": "bidi-isolate",
      "input": {
        "text": "a\u2067b\u2069"
      },
      "output": "bidirectional override/isolate"
    },
    {
      "id": "lone-high",
      "input": {
        "text": "x\ud800"
      },
      "output": "unpaired surrogate"
    },
    {
      "id": "lone-low",
      "input": {
        "text": "\udc00x"
      },
      "output": "unpaired surrogate"
    },
    {
      "id": "bidi-and-control",
      "input": {
        "text": "\u202ex\u0007"
      },
      "output": "control or terminal escape sequence"
    }
  ]
}
