{
  "kind": "pure-fn/v1",
  "offsets": "utf16",
  "provenance": {
    "source": "experiments/engine-v2/unicode.test.ts (\"Unicode conversions round trip strictly at valid boundaries\"); outputs: index i is UTF-16 offset i converted, null inside a character",
    "license": "Apache-2.0 OR MIT",
    "author": "murmo"
  },
  "fn": "text.offsets",
  "cases": [
    {
      "id": "empty",
      "input": {
        "text": ""
      },
      "output": {
        "codePoint": [0],
        "utf8": [0],
        "grapheme": [0]
      }
    },
    {
      "id": "ascii",
      "input": {
        "text": "abc"
      },
      "output": {
        "codePoint": [0, 1, 2, 3],
        "utf8": [0, 1, 2, 3],
        "grapheme": [0, 1, 2, 3]
      }
    },
    {
      "id": "emoji",
      "input": {
        "text": "😀teh"
      },
      "output": {
        "codePoint": [0, null, 1, 2, 3, 4],
        "utf8": [0, null, 4, 5, 6, 7],
        "grapheme": [0, null, 1, 2, 3, 4]
      }
    },
    {
      "id": "zwj-tone",
      "input": {
        "text": "👩🏽\u200d💻 teh"
      },
      "output": {
        "codePoint": [0, null, 1, null, 2, 3, null, 4, 5, 6, 7, 8],
        "utf8": [0, null, 4, null, 8, 11, null, 15, 16, 17, 18, 19],
        "grapheme": [0, null, null, null, null, null, null, 1, 2, 3, 4, 5]
      }
    },
    {
      "id": "flag",
      "input": {
        "text": "🇺🇦teh"
      },
      "output": {
        "codePoint": [0, null, 1, null, 2, 3, 4, 5],
        "utf8": [0, null, 4, null, 8, 9, 10, 11],
        "grapheme": [0, null, null, null, 1, 2, 3, 4]
      }
    },
    {
      "id": "tone",
      "input": {
        "text": "👍🏽teh"
      },
      "output": {
        "codePoint": [0, null, 1, null, 2, 3, 4, 5],
        "utf8": [0, null, 4, null, 8, 9, 10, 11],
        "grapheme": [0, null, null, null, 1, 2, 3, 4]
      }
    },
    {
      "id": "combining",
      "input": {
        "text": "e\u0301 teh"
      },
      "output": {
        "codePoint": [0, 1, 2, 3, 4, 5, 6],
        "utf8": [0, 1, 3, 4, 5, 6, 7],
        "grapheme": [0, null, 1, 2, 3, 4, 5]
      }
    },
    {
      "id": "cjk-crlf",
      "input": {
        "text": "日本語\r\nteh"
      },
      "output": {
        "codePoint": [0, 1, 2, 3, 4, 5, 6, 7, 8],
        "utf8": [0, 3, 6, 9, 10, 11, 12, 13, 14],
        "grapheme": [0, 1, 2, 3, null, 4, 5, 6, 7]
      }
    },
    {
      "id": "crlf-mid",
      "input": {
        "text": "x\r\ny"
      },
      "output": {
        "codePoint": [0, 1, 2, 3, 4],
        "utf8": [0, 1, 2, 3, 4],
        "grapheme": [0, 1, null, 2, 3]
      }
    },
    {
      "id": "crlf",
      "input": {
        "text": "\r\n"
      },
      "output": {
        "codePoint": [0, 1, 2],
        "utf8": [0, 1, 2],
        "grapheme": [0, null, 1]
      }
    }
  ]
}
