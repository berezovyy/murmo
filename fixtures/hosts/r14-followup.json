    {
      "id": "status-hidden-without-dialog-safe",
      "tags": ["dialog-status"],
      "note": "OpenCode cannot report its approval dialog, so a third-party plugin's status stays hidden unless the host proves dialog safety: its text could pass for the host's own prompt.",
      "trust": "third-party",
      "plugins": [
        {
          "id": "A",
          "plugin": "conflicts",
          "settings": {
            "letter": "A"
          }
        },
        {
          "id": "B",
          "plugin": "conflicts",
          "settings": {
            "letter": "B"
          }
        },
        {
          "id": "guard",
          "plugin": "conflicts",
          "settings": {
            "guard": true
          }
        }
      ],
      "host": {
        "dialogSafe": false
      },
      "steps": [
        {
          "type": "r14status"
        }
      ],
      "expect": {
        "ui": {
          "status": null
        }
      },
      "grants": {
        "A": ["draft:read:full", "submit"],
        "B": ["draft:read:full", "submit"],
        "guard": ["draft:read:full", "submit"]
      }
    },
    {
      "id": "third-party-status-shown-with-dialog-safe",
      "tags": ["dialog-status"],
      "note": "The control for the hidden case: with dialog safety a third-party status shows, under its plugin tag.",
      "trust": "third-party",
      "plugins": [
        {
          "id": "A",
          "plugin": "conflicts",
          "settings": {
            "letter": "A"
          }
        }
      ],
      "host": {
        "dialogSafe": true
      },
      "steps": [
        {
          "type": "r14status"
        }
      ],
      "expect": {
        "ui": {
          "statusIncludes": "[plugin A] R14_STATUS_A"
        }
      },
      "grants": {
        "A": ["draft:read:full", "submit"]
      }
