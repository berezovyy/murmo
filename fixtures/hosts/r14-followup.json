  "cases": [
    {
      "id": "order-AB-ghost",
      "requires": ["core.keys"],
      "tags": ["order"],
      "plugins": [
        {
          "id": "A",
          "plugin": "conflicts",
          "settings": {
            "letter": "A"
          }
        },
        {
          "id": "B",
          "plugin": "conflicts",
          "settings": {
            "letter": "B"
          }
        },
        {
          "id": "guard",
          "plugin": "conflicts",
          "settings": {
            "guard": true
          }
        }
      ],
      "steps": [
        {
          "type": "r14key "
        },
        {
          "check": {
            "ui": {
              "ghost": "A"
            }
          }
        },
        {
          "key": "F6",
          "routing": "consume"
        }
      ],
      "expect": {
        "draft": {
          "text": "r14key A"
        }
      }
    },
    {
