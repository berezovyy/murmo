    {
      "id": "status-hidden-over-dialog",
      "tags": ["dialog-status"],
      "plugins": [
        {
          "id": "A",
          "plugin": "conflicts",
          "settings": {
            "letter": "A"
          }
        },
        {
          "id": "B",
          "plugin": "conflicts",
          "settings": {
            "letter": "B"
          }
        },
        {
          "id": "guard",
          "plugin": "conflicts",
          "settings": {
            "guard": true
          }
        }
      ],
      "host": {
        "dialogSafe": true
      },
      "steps": [
        {
          "type": "r14status"
        },
        {
          "check": {
            "ui": {
              "statusIncludes": "R14_STATUS_"
            }
          }
        },
        {
          "state": {
            "dialog": true
          }
        }
      ],
      "expect": {
        "ui": {
          "status": null
        }
      }
