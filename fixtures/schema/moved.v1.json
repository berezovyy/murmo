{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moved.v1.json",
  "description": "Files moved byte for byte from an experiment. Each must still match its source's SHA-256: CRLF, emoji and combining marks are the point of these files (E17, E18; lesson 26).",
  "type": "object",
  "required": ["kind", "provenance", "files"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "moved/v1" },
    "provenance": { "$ref": "common.json#/$defs/provenance" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "source", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[\\w.][\\w./-]*$" },
          "source": { "type": "string", "pattern": "^experiments/" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
