{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suites.v1.json",
  "description": "fixtures/suites.json: every fixture file with its owning phase and declared size. A file missing from the index, an indexed file missing on disk, or a size that differs fails the run (anti-vacuity).",
  "type": "object",
  "required": ["kind", "suites"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "suites/v1" },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "owner"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.json$" },
          "owner": { "type": "string", "pattern": "^\\d\\d(, \\d\\d)*$" },
          "cases": { "type": "integer", "minimum": 1 },
          "variants": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
