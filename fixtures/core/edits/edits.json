      },
      "steps": [
        {
          "key": "t"
        },
        {
          "key": "e"
        },
        {
          "key": "h"
        },
        {
          "key": " "
        },
        {
          "check": {
            "draft": {
              "text": "teh ",
              "cursor": 4
            },
            "stats": {
              "undoDepth": 0,
              "commits.cancelled": 1
            }
          }
        },
        {
          "key": "Backspace",
          "routing": "pass"
        }
      ],
      "expect": {
        "draft": {
          "text": "teh",
          "cursor": 3
        },
        "edits": {
          "applied": 0
        },
        "stats": {
          "applied": 0,
          "restores": 0
        }
      }
    },
