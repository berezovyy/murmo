        }
      }
    },
    {
      "id": "commit-error",
      "tags": ["commit-failure"],
      "note": "The host answers every commit `error`: nothing changes, no undo is armed, and Backspace goes to the host.",
      "host": {
        "commitStatus": "error"
      },
      "steps": [
        {
          "key": "t"
        },
        {
          "key": "e"
        },
        {
          "key": "h"
        },
        {
          "key": " "
        },
        {
          "check": {
            "draft": {
              "text": "teh ",
              "cursor": 4
            },
            "stats": {
              "undoDepth": 0,
              "commits.error": 1
            }
          }
        },
        {
          "key": "Backspace",
          "routing": "pass"
        }
      ],
      "expect": {
        "draft": {
          "text": "teh",
          "cursor": 3
        },
        "edits": {
          "applied": 0
        },
        "stats": {
