{
  "kind": "editor-ops/v1",
  "offsets": "utf16",
  "provenance": {
    "source": "new (phase 05): commit failures, the undo window, pending merge, degraded origin and presentation; the interleaved undo from experiments/platform/core/fuzz.mjs",
    "license": "Apache-2.0 OR MIT",
    "author": "murmo"
  },
  "defaults": {
    "plugins": ["autocorrect"],
    "trust": "both",
    "requires": ["core.edits"]
  },
  "cases": [
    {
      "id": "commit-stale",
      "tags": ["commit-failure"],
      "note": "The host answers every commit `stale`: nothing changes, no undo is armed, and Backspace goes to the host.",
      "host": {
        "commitStatus": "stale"
      },
      "steps": [
        {
          "key": "t"
        },
        {
          "key": "e"
        },
        {
          "key": "h"
        },
        {
          "key": " "
        },
        {
          "check": {
            "draft": {
              "text": "teh ",
              "cursor": 4
            },
            "stats": {
              "undoDepth": 0,
              "commits.stale": 1
            }
          }
        },
        {
          "key": "Backspace",
          "routing": "pass"
        }
      ],
      "expect": {
        "draft": {
          "text": "teh",
          "cursor": 3
        },
        "edits": {
          "applied": 0
        },
        "stats": {
          "applied": 0,
          "restores": 0
        }
      }
    },
    {
      "id": "commit-cancelled",
      "tags": ["commit-failure"],
      "note": "The host answers every commit `cancelled`: nothing changes, no undo is armed, and Backspace goes to the host.",
