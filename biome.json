{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!experiments",
      "!**/dist",
      "!docs",
      "!fixtures/shortcuts/replacements",
      "!fixtures/names/splitter-fixture.json",
      "!fixtures/lang-en/clean-400k-counts.json",
      "!fixtures/lang-en/test-counts.json",
      "!packages/api/report"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "linter": {
    "rules": { "preset": "recommended" }
  }
}
