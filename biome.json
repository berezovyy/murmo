{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!experiments",
      "!**/dist",
      "!docs",
      "!fixtures/shortcuts/replacements",
      "!fixtures/names/splitter-fixture.json",
      "!fixtures/lang-en/clean-400k-counts.json",
      "!fixtures/lang-en/test-counts.json",
      "!packages/api/report"
    ]
  },
  "overrides": [
    {
      "includes": ["fixtures/hosts/configs/**"],
      "json": { "parser": { "allowComments": true } }
    }
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "plugins": ["./tools/lint/no-bun-toml.grit"],
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "bun": {
                "importNames": ["TOML"],
                "message": "Bun's built-in TOML parser is not allowed: parse with @murmo/config (smol-toml)."
              }
            },
            "patterns": [
              {
                "group": ["**/*.toml", "*.toml"],
                "message": "Importing a .toml file uses Bun's built-in TOML parser: read the file and parse it with @murmo/config."
              }
            ]
          }
        }
      }
    }
  }
}
