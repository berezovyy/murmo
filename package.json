{
  "name": "murmo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:verify": "node tools/build.mjs --verify-deterministic",
    "check": "node tools/typecheck.mjs",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "test": "tools/offline/run.sh node tools/test-all.mjs",
    "test:portable": "tools/offline/run.sh node tools/test-portable.mjs",
    "test:conformance": "tools/offline/run.sh node tools/test-conformance.mjs",
    "test:harness": "python3 -I harness/tests/run.py",
    "harness": "python3 -I harness/harness.py",
    "check:licenses": "node tools/licenses.mjs",
    "api:report": "node tools/api-report.mjs --write",
    "check:api": "node tools/api-report.mjs --check",
    "rust": "node tools/cargo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "quickjs-emscripten": "0.32.0",
    "typescript": "7.0.2"
  }
}
